<div class="trust-bar">
  <div class="page-width">
    <div class="trust-bar__grid">

      {% for block in section.blocks %}

        <div class="trust-item" {{ block.shopify_attributes }}>

          <div class="trust-item__icon">
            {{ block.settings.icon }}
          </div>

          <div>
            <h3>{{ block.settings.heading }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>

        </div>

      {% endfor %}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Trust bar (basic)",
  "tag": "section",
  "class": "trust-bar-section",
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        {
          "type": "trust"
        },
        {
          "type": "trust"
        },
        {
          "type": "trust"
        }
      ]
    }
  ]
}
{% endschema %}
