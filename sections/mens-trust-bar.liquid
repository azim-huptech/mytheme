{{ 'mens-theme.css' | asset_url | stylesheet_tag }}

<section class="mens-trust">
  <div class="mens-wrap">
    <div class="mens-trust__grid">
      {%- for block in section.blocks -%}
        <div class="mens-trust__item" {{ block.shopify_attributes }}>
          <div class="mens-trust__icon">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v10H3zM14 10h4l3 4v3h-7zM7 20a2 2 0 100-4 2 2 0 000 4zM17 20a2 2 0 100-4 2 2 0 000 4z"/></svg>
              {%- when 'return' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12a8 8 0 018-8c3 0 5.5 1.5 7 4"/><path d="M20 4v5h-5"/><path d="M20 12a8 8 0 01-8 8c-3 0-5.5-1.5-7-4"/><path d="M4 20v-5h5"/></svg>
              {%- when 'secure' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 118 0v3"/></svg>
              {%- when 'support' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M8 13s1.5 2 4 2 4-2 4-2"/><path d="M9 9h.01M15 9h.01"/></svg>
              {%- when 'tag' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 13l-7 7-9-9V4h7l9 9z"/><circle cx="8" cy="8" r="1.5"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
            {%- endcase -%}
          </div>
          <div>
            <h3 class="mens-trust__heading">{{ block.settings.heading }}</h3>
            <p class="mens-trust__text">{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mens trust bar",
  "tag": "section",
  "class": "mens-trust-bar",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Truck" },
          { "value": "return", "label": "Return" },
          { "value": "secure", "label": "Secure" },
          { "value": "support", "label": "Support" },
          { "value": "tag", "label": "Tag" }
        ], "default": "truck" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Free shipping" },
        { "type": "text", "id": "text", "label": "Description", "default": "On all orders over $75" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mens trust bar",
      "blocks": [
        { "type": "trust", "settings": { "icon": "truck", "heading": "Free shipping", "text": "On all orders over $75" } },
        { "type": "trust", "settings": { "icon": "return", "heading": "30-day returns", "text": "Free, hassle-free returns" } },
        { "type": "trust", "settings": { "icon": "secure", "heading": "Secure payment", "text": "Encrypted checkout" } },
        { "type": "trust", "settings": { "icon": "support", "heading": "Dedicated support", "text": "Chat with us 7 days a week" } }
      ]
    }
  ]
}
{% endschema %}
