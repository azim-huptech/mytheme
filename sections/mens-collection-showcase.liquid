{{ 'mens-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mens-theme.js' | asset_url }}" defer></script>

<section class="mens-section mens-section--soft">
  <div class="mens-wrap">
    <div class="mens-showcase" data-mens-scroll>
      <div class="mens-showcase__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="mens-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="mens-showcase__title">{{ section.settings.heading | default: 'Shop by collection' }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="mens-showcase__desc">{{ section.settings.description }}</p>
        {%- endif -%}
        <div class="mens-showcase__nav">
          <button type="button" class="mens-showcase__arrow" data-mens-scroll-prev aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M15 18l-6-6 6-6"/></svg></button>
          <button type="button" class="mens-showcase__arrow" data-mens-scroll-next aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
      </div>
      <div class="mens-showcase__scroll" data-mens-scroll-track>
        {%- for block in section.blocks -%}
          {%- assign col = block.settings.collection -%}
          {%- assign fallback_img = block.settings.image -%}
          <a href="{{ block.settings.link | default: col.url }}" class="mens-showcase__card" {{ block.shopify_attributes }}>
            <div class="mens-showcase__card-media">
              {%- if fallback_img != blank -%}
                {{ fallback_img | image_url: width: 600 | image_tag: loading: 'lazy', widths: '320,480,600', sizes: '300px', class: 'mens-showcase__img', alt: block.settings.heading | escape }}
              {%- elsif col.featured_image != blank -%}
                {{ col.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '320,480,600', sizes: '300px', class: 'mens-showcase__img', alt: col.title | escape }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg mens-showcase__img' }}
              {%- endif -%}
            </div>
            <div class="mens-showcase__meta">
              <div>
                <h3>{{ block.settings.heading | default: col.title }}</h3>
                <p>{%- if col.all_products_count > 0 -%}{{ col.all_products_count }} items{%- else -%}{{ block.settings.subtitle | default: 'View collection' }}{%- endif -%}</p>
              </div>
              <span class="mens-showcase__go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M7 17L17 7M9 7h8v8"/></svg></span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mens collection showcase",
  "tag": "section",
  "class": "mens-collection-showcase",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Men's essentials" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Thoughtfully crafted pieces that last — built for your everyday rotation." },
    { "type": "paragraph", "content": "Each card uses a fixed 1:1 image area. Any image you upload is cropped to fit — the card never grows with the image." }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Collection card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Override image" },
        { "type": "text", "id": "heading", "label": "Override title" },
        { "type": "text", "id": "subtitle", "label": "Override subtitle" },
        { "type": "url", "id": "link", "label": "Override link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mens collection showcase",
      "blocks": [
        { "type": "card", "settings": { "heading": "Shirts" } },
        { "type": "card", "settings": { "heading": "Jackets" } },
        { "type": "card", "settings": { "heading": "Trousers" } },
        { "type": "card", "settings": { "heading": "Shoes" } }
      ]
    }
  ]
}
{% endschema %}
