{{ 'mens-theme.css' | asset_url | stylesheet_tag }}

<footer class="mens-footer">
  <div class="mens-wrap">
    <div class="mens-footer__grid">

      <div class="mens-footer__brand">
        {%- if section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150,300', alt: shop.name, class: 'mens-footer__logo' }}
        {%- else -%}
          <h3>{{ section.settings.brand_name | default: shop.name }}</h3>
        {%- endif -%}
        <p>{{ section.settings.tagline }}</p>
        <div class="mens-footer__social">
          {%- for block in section.blocks -%}
            {%- if block.type == 'social' -%}
              <a href="{{ block.settings.link }}" aria-label="{{ block.settings.label }}" {{ block.shopify_attributes }}>
                {%- case block.settings.network -%}
                  {%- when 'instagram' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="16" height="16"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
                  {%- when 'facebook' -%}<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.3-1.5 1.6-1.5h1.6V4.6c-.3 0-1.3-.1-2.4-.1-2.3 0-3.9 1.4-3.9 4v2.4H7.6V14h2.8v8h3.1z"/></svg>
                  {%- when 'tiktok' -%}<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M20 8.5a7 7 0 01-4-1.3V15a6 6 0 11-6-6v3a3 3 0 103 3V2h3a4 4 0 004 4v2.5z"/></svg>
                  {%- when 'youtube' -%}<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M22 8.1c-.2-1.4-.8-2.4-2.3-2.6C17.3 5 12 5 12 5s-5.3 0-7.7.5C2.8 5.7 2.2 6.7 2 8.1 1.5 10.5 1.5 12 1.5 12s0 1.5.5 3.9c.2 1.4.8 2.4 2.3 2.6 2.4.5 7.7.5 7.7.5s5.3 0 7.7-.5c1.5-.2 2.1-1.2 2.3-2.6.5-2.4.5-3.9.5-3.9s0-1.5-.5-3.9zM10 15V9l5 3-5 3z"/></svg>
                  {%- when 'x' -%}<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M18 3h3l-7.3 8.3L22 21h-6l-5-6-6 6H2l7.8-8.8L2 3h6l4.5 5.5L18 3z"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><circle cx="12" cy="12" r="3"/></svg>
                {%- endcase -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          {%- assign m = linklists[block.settings.menu] -%}
          <div class="mens-footer__col" {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <ul>
              {%- for link in m.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
              {%- if m.links.size == 0 -%}
                <li><a href="#">About us</a></li>
                <li><a href="#">Shipping & returns</a></li>
                <li><a href="#">Size guide</a></li>
                <li><a href="#">FAQ</a></li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="mens-footer__news">
        <h4>{{ section.settings.newsletter_heading }}</h4>
        <p>{{ section.settings.newsletter_text }}</p>
        {%- form 'customer', id: 'MensFooterNewsletter', class: '' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="Enter your email" required>
          <button type="submit">Subscribe</button>
        {%- endform -%}
      </div>
    </div>

    <div class="mens-footer__bottom">
      <div>© {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.rights | default: 'All rights reserved.' }}</div>
      <div>
        {%- if shop.enabled_payment_types.size > 0 -%}
          {%- for type in shop.enabled_payment_types -%}
            <span style="display:inline-block; margin-left:6px;">{{ type | payment_type_svg_tag: class: 'payment-icon' }}</span>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Mens footer",
  "tag": "section",
  "class": "mens-footer-section",
  "max_blocks": 8,
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "YOURSTORE" },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Timeless menswear essentials — made to last, priced to love." },
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "newsletter_heading", "label": "Heading", "default": "Join the club" },
    { "type": "text", "id": "newsletter_text", "label": "Text", "default": "Get 10% off your first order + early access to drops." },
    { "type": "text", "id": "rights", "label": "Rights text", "default": "All rights reserved." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "social",
      "name": "Social link",
      "settings": [
        { "type": "select", "id": "network", "label": "Network", "options": [
          { "value": "instagram", "label": "Instagram" },
          { "value": "facebook", "label": "Facebook" },
          { "value": "tiktok", "label": "TikTok" },
          { "value": "youtube", "label": "YouTube" },
          { "value": "x", "label": "X / Twitter" }
        ], "default": "instagram" },
        { "type": "url", "id": "link", "label": "URL" },
        { "type": "text", "id": "label", "label": "Accessibility label", "default": "Follow us" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mens footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Help" } },
        { "type": "menu", "settings": { "heading": "Company" } },
        { "type": "social", "settings": { "network": "instagram" } },
        { "type": "social", "settings": { "network": "facebook" } },
        { "type": "social", "settings": { "network": "tiktok" } }
      ]
    }
  ]
}
{% endschema %}
