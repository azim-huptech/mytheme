{{ 'mens-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mens-theme.js' | asset_url }}" defer></script>

{%- assign threshold_cents = section.settings.free_ship_threshold | times: 100 -%}
{%- assign remaining = threshold_cents | minus: cart.total_price -%}

<div class="mens-wrap">
  <div class="mens-cart-benefits"
       data-mens-shipbar
       data-threshold="{{ threshold_cents }}"
       data-subtotal="{{ cart.total_price }}"
       data-msg-done="{{ section.settings.free_ship_done | escape }}">
    {%- if section.settings.show_shipping_bar -%}
      <div class="mens-cart-benefits__bar">
        <p data-mens-shipbar-msg>
          {%- if remaining > 0 -%}
            {{ section.settings.free_ship_message | replace: '[remaining]', remaining | money }}
          {%- else -%}
            {{ section.settings.free_ship_done }}
          {%- endif -%}
        </p>
        <div class="mens-cart-benefits__track"><span class="mens-cart-benefits__fill" data-mens-shipbar-fill></span></div>
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <div class="mens-cart-benefits__item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'return' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 12a8 8 0 018-8c3 0 5.5 1.5 7 4"/><path d="M20 4v5h-5"/></svg>
          {%- when 'secure' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 118 0v3"/></svg>
          {%- when 'support' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M8 13s1.5 2 4 2 4-2 4-2"/></svg>
          {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 4v3h-7z"/></svg>
        {%- endcase -%}
        <span>{{ block.settings.text }}</span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart benefits",
  "tag": "section",
  "class": "mens-cart-benefits-section",
  "enabled_on": { "templates": ["cart"] },
  "max_blocks": 4,
  "settings": [
    { "type": "checkbox", "id": "show_shipping_bar", "label": "Show free shipping progress", "default": true },
    { "type": "range", "id": "free_ship_threshold", "label": "Free shipping threshold", "min": 0, "max": 500, "step": 5, "default": 75, "unit": "$" },
    { "type": "text", "id": "free_ship_message", "label": "Message", "default": "You're [remaining] away from free shipping." },
    { "type": "text", "id": "free_ship_done", "label": "Message when unlocked", "default": "🎉 You unlocked free shipping!" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "truck", "label": "Truck" },
          { "value": "return", "label": "Return" },
          { "value": "secure", "label": "Secure" },
          { "value": "support", "label": "Support" }
        ], "default": "truck" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $75" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cart benefits",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "truck", "text": "Free shipping on orders over $75" } },
        { "type": "benefit", "settings": { "icon": "return", "text": "30-day easy returns" } },
        { "type": "benefit", "settings": { "icon": "secure", "text": "Secure checkout" } }
      ]
    }
  ]
}
{% endschema %}
