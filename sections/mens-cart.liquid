{{ 'mens-theme.css' | asset_url | stylesheet_tag }}
{{ 'mens-pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mens-pages.js' | asset_url }}" defer></script>

{%- liquid
  assign savings = 0
  for item in cart.items
    if item.variant.compare_at_price > item.variant.price
      assign line_save = item.variant.compare_at_price | minus: item.variant.price | times: item.quantity
      assign savings = savings | plus: line_save
    endif
  endfor
  assign savings = savings | plus: cart.total_discount
-%}

<div class="mens-page mens-cartp">
  <div class="mens-wrap">
    <div class="mens-cartp__head">
      <div>
        <h1 class="mens-page__title">{{ section.settings.heading }}</h1>
        {%- if cart.item_count > 0 -%}
          <p>{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %} in your bag</p>
        {%- endif -%}
      </div>
      {%- if cart.item_count > 0 -%}
        <a class="mens-cartp__continue" href="{{ routes.all_products_collection_url }}">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 6l-6 6 6 6"/></svg>
          Continue shopping
        </a>
      {%- endif -%}
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="mens-empty">
        <span class="mens-empty__icon">
          <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 7h12l-1.5 11.2a2 2 0 01-2 1.8h-5a2 2 0 01-2-1.8L6 7z"/><path d="M9 7V5a3 3 0 016 0v2"/></svg>
        </span>
        <h2>Your cart is empty</h2>
        <p>Looks like you haven't added anything yet.</p>
        <a href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}" class="mens-btn mens-btn--primary">Start shopping</a>
        {%- unless customer -%}
          {%- if shop.customer_accounts_enabled -%}
            <p style="margin:18px 0 0;font-size:14px;">Have an account? <a href="{{ routes.account_login_url }}" class="mens-link">Log in</a> to see your saved cart.</p>
          {%- endif -%}
        {%- endunless -%}
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" class="mens-cartp__grid" data-mens-cart-form novalidate>
        {%- comment -%} First submit button = default for Enter key, so Enter updates instead of checking out {%- endcomment -%}
        <button type="submit" name="update" class="mens-visually-hidden" data-mens-update tabindex="-1">Update cart</button>

        <div>
          <div class="mens-cartp__colhead" aria-hidden="true">
            <span>Product</span><span>Quantity</span><span style="text-align:right;">Total</span>
          </div>
          <div class="mens-cartp__items">
            {%- for item in cart.items -%}
              <article class="mens-citem">
                <a href="{{ item.url }}" class="mens-citem__media">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: item.title | escape }}
                  {%- else -%}
                    {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </a>

                <div>
                  {%- if section.settings.show_vendor and item.vendor != blank -%}
                    <p class="mens-citem__vendor">{{ item.vendor }}</p>
                  {%- endif -%}
                  <h2 class="mens-citem__title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>

                  {%- assign has_meta = false -%}
                  {%- unless item.product.has_only_default_variant -%}{%- assign has_meta = true -%}{%- endunless -%}
                  {%- if item.properties.size > 0 or item.selling_plan_allocation -%}{%- assign has_meta = true -%}{%- endif -%}
                  {%- if has_meta -%}
                    <ul class="mens-citem__opts">
                      {%- unless item.product.has_only_default_variant -%}
                        {%- for option in item.options_with_values -%}
                          <li>{{ option.name }}: {{ option.value }}</li>
                        {%- endfor -%}
                      {%- endunless -%}
                      {%- for property in item.properties -%}
                        {%- assign first_char = property.first | slice: 0 -%}
                        {%- if property.last != blank and first_char != '_' -%}
                          <li>{{ property.first }}: {% if property.last contains '/uploads/' %}<a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>{% else %}{{ property.last }}{% endif %}</li>
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if item.selling_plan_allocation -%}<li>{{ item.selling_plan_allocation.selling_plan.name }}</li>{%- endif -%}
                    </ul>
                  {%- endif -%}

                  <div class="mens-citem__unit">
                    <span>{{ item.final_price | money }}</span>
                    {%- if item.original_price > item.final_price -%}
                      <s>{{ item.original_price | money }}</s>
                    {%- elsif item.variant.compare_at_price > item.variant.price -%}
                      <s>{{ item.variant.compare_at_price | money }}</s>
                    {%- endif -%}
                  </div>
                  {%- for discount in item.line_level_discount_allocations -%}
                    <p class="mens-citem__disc">
                      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.6 13.4l-7.2 7.2a2 2 0 01-2.8 0L3 13V3h10l7.6 7.6a2 2 0 010 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
                      {{ discount.discount_application.title }} (−{{ discount.amount | money }})
                    </p>
                  {%- endfor -%}
                </div>

                <div class="mens-citem__qty">
                  <div class="mens-qty mens-qty--sm" data-mens-qty>
                    <button type="button" data-minus aria-label="Decrease quantity of {{ item.product.title | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/></svg></button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"
                      {% if item.variant.quantity_rule.max %}max="{{ item.variant.quantity_rule.max }}"{% endif %}
                      aria-label="Quantity of {{ item.product.title | escape }}">
                    <button type="button" data-plus aria-label="Increase quantity of {{ item.product.title | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></button>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="mens-citem__remove">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 002 2h6a2 2 0 002-2l1-12M9 7V4h6v3"/></svg>
                    Remove
                  </a>
                </div>

                <div class="mens-citem__total" data-label="Total">
                  <span>
                    {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                    {{ item.final_line_price | money }}
                  </span>
                </div>
              </article>
            {%- endfor -%}
          </div>
        </div>

        <aside class="mens-cartp__summary" aria-label="Order summary">
          <h2>Order summary</h2>

          <div class="mens-sumrow"><span>Subtotal</span><span>{{ cart.items_subtotal_price | money }}</span></div>
          {%- for discount in cart.cart_level_discount_applications -%}
            <div class="mens-sumrow mens-sumrow--disc"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
          {%- endfor -%}
          <div class="mens-sumrow"><span>Shipping</span><span>{{ section.settings.shipping_text }}</span></div>
          <div class="mens-sumrow mens-sumrow--total"><span>Total</span><span>{{ cart.total_price | money_with_currency }}</span></div>
          {%- if section.settings.tax_text != blank -%}
            <p style="margin:-6px 0 0;font-size:12px;color:var(--mens-muted);">{{ section.settings.tax_text }}</p>
          {%- endif -%}

          {%- if savings > 0 and section.settings.show_savings -%}
            <div class="mens-cartp__savings">You're saving {{ savings | money }} on this order</div>
          {%- endif -%}

          {%- if section.settings.show_note -%}
            <details class="mens-cartp__note"{% if cart.note != blank %} open{% endif %}>
              <summary>
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z"/></svg>
                Add order note
              </summary>
              <textarea class="mens-input" name="note" placeholder="Gift message or delivery instructions">{{ cart.note }}</textarea>
            </details>
          {%- endif -%}

          <button type="submit" name="checkout" class="mens-btn mens-btn--primary mens-btn--block" style="padding:16px 24px;font-size:15px;">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 118 0v3"/></svg>
            Checkout · {{ cart.total_price | money }}
          </button>

          {%- if additional_checkout_buttons and section.settings.show_dynamic -%}
            <div class="mens-cartp__dynamic">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}

          <p class="mens-cartp__secure">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/></svg>
            Secure, encrypted checkout
          </p>
          {%- if shop.enabled_payment_types.size > 0 -%}
            <div class="mens-cartp__pay">
              {%- for type in shop.enabled_payment_types limit: 8 -%}{{ type | payment_type_svg_tag }}{%- endfor -%}
            </div>
          {%- endif -%}
        </aside>
      </form>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Mens cart",
  "tag": "section",
  "class": "mens-cart-section",
  "enabled_on": { "templates": ["cart"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your cart" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "text", "id": "shipping_text", "label": "Shipping line", "default": "Calculated at checkout" },
    { "type": "text", "id": "tax_text", "label": "Tax note", "default": "Inclusive of all taxes" },
    { "type": "checkbox", "id": "show_savings", "label": "Show \"You're saving\" banner", "default": true },
    { "type": "checkbox", "id": "show_note", "label": "Allow order note", "default": true },
    { "type": "checkbox", "id": "show_dynamic", "label": "Show express checkout buttons", "default": true },
    { "type": "url", "id": "empty_link", "label": "Empty cart button link" }
  ]
}
{% endschema %}
