{{ 'mens-theme.css' | asset_url | stylesheet_tag }}

<section class="mens-section">
  <div class="mens-wrap">
    <div class="mens-promos">
      {%- for block in section.blocks -%}
        <article class="mens-promo mens-promo--{{ block.settings.tone }}"
                 style="background: {{ block.settings.background_color }};"
                 {{ block.shopify_attributes }}>
          <div class="mens-promo__inner">
            {%- if block.settings.heading != blank -%}
              <h3 class="mens-promo__title" style="color: {{ block.settings.text_color }};">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="mens-promo__text" style="color: {{ block.settings.text_color }};">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a href="{{ block.settings.button_link }}" class="mens-btn mens-btn--primary">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
          {%- if block.settings.image != blank -%}
            <div class="mens-promo__img">
              {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,700,900', sizes: '(min-width: 990px) 40vw, 100vw', alt: block.settings.heading | escape }}
            </div>
          {%- endif -%}
          {%- if block.settings.save_amount != blank -%}
            <span class="mens-promo__save" style="background: {{ block.settings.save_color }};">
              Save <strong>{{ block.settings.save_amount }}</strong>
            </span>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mens promo banners",
  "tag": "section",
  "class": "mens-promo-banners",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "banner",
      "name": "Promo banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Product image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Autumn Shirts" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Elevate your wardrobe with 40% off hand-picked styles." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "color", "id": "background_color", "label": "Background", "default": "#f7dadf" },
        { "type": "color", "id": "text_color", "label": "Text colour", "default": "#0f0f10" },
        { "type": "select", "id": "tone", "label": "Preset tone", "options": [
          { "value": "pink", "label": "Pink" },
          { "value": "mint", "label": "Mint" },
          { "value": "sand", "label": "Sand" },
          { "value": "sky", "label": "Sky" }
        ], "default": "pink" },
        { "type": "header", "content": "Save badge (optional)" },
        { "type": "text", "id": "save_amount", "label": "Save amount", "default": "40%" },
        { "type": "color", "id": "save_color", "label": "Badge colour", "default": "#e6e86a" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mens promo banners",
      "blocks": [
        { "type": "banner", "settings": { "heading": "Autumn Shirts", "text": "Elevate your wardrobe with 40% off hand-picked styles.", "tone": "pink", "save_amount": "40%", "save_color": "#f4e872" } },
        { "type": "banner", "settings": { "heading": "Chore Jackets", "text": "Timeless layering pieces, now 30% off.", "tone": "mint", "save_amount": "30%", "save_color": "#e03a2f", "background_color": "#d5ecd8" } }
      ]
    }
  ]
}
{% endschema %}
