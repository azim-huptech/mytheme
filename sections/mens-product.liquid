{{ 'mens-theme.css' | asset_url | stylesheet_tag }}
{{ 'mens-pages.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mens-pages.js' | asset_url }}" defer></script>

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media_id = current_variant.featured_media.id | default: product.featured_media.id

  assign on_sale = false
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
    assign off_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif

  assign subtitle = product.metafields.custom.subtitle.value | default: product.metafields.descriptors.subtitle.value
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
-%}

{%- capture chevron_r -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>{%- endcapture -%}
{%- capture plus_icon -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>{%- endcapture -%}

<div class="mens-page mens-pdp" data-mens-pdp>
  <div class="mens-wrap">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="mens-crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        {{ chevron_r }}
        {%- if collection -%}
          <a href="{{ collection.url }}">{{ collection.title | truncate: 28 }}</a>
        {%- else -%}
          <a href="{{ routes.all_products_collection_url }}">Shop</a>
        {%- endif -%}
        {{ chevron_r }}
        <span aria-current="page">{{ product.title | truncate: 40 }}</span>
      </nav>
    {%- endif -%}

    <div class="mens-pdp__grid">
      {%- comment -%} ===== Gallery: thumbnail rail + stage ===== {%- endcomment -%}
      <div class="mens-pdp__gallery">
        {%- if product.media.size > 1 -%}
          <div class="mens-pdp__thumbs" role="tablist" aria-label="Product images">
            {%- for media in product.media -%}
              <button type="button" class="mens-pdp__thumb{% if media.id == featured_media_id %} is-active{% endif %}" data-mens-thumb aria-label="Show image {{ forloop.index }}">
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                  <span class="mens-pdp__thumb-play"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
                {%- endif -%}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="mens-pdp__stage{% if section.settings.media_fit == 'cover' %} mens-pdp__stage--cover{% endif %}" data-mens-stage style="aspect-ratio: {{ section.settings.media_ratio }};{% if product.media.size <= 1 %} grid-column: 1 / -1;{% endif %}">
          {%- if on_sale and section.settings.show_sale_badge -%}
            <span class="mens-pdp__badge mens-gcard__badge mens-gcard__badge--sale">{{ off_pct }}% Off</span>
          {%- endif -%}

          {%- for media in product.media -%}
            <div class="mens-pdp__slide{% if media.id == featured_media_id %} is-active{% endif %}" data-mens-slide data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- assign img_loading = 'lazy' -%}
                  {%- if media.id == featured_media_id -%}{%- assign img_loading = 'eager' -%}{%- endif -%}
                  {{ media | image_url: width: 1400 | image_tag:
                    loading: img_loading,
                    widths: '500,700,900,1100,1400',
                    sizes: '(min-width: 990px) 50vw, 100vw',
                    alt: media.alt | default: product.title | escape }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1200x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- else -%}
                  {{ media | media_tag: image_size: '1200x' }}
              {%- endcase -%}
            </div>
          {%- else -%}
            <div class="mens-pdp__slide is-active" data-mens-slide>
              {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endfor -%}

          {%- if product.media.size > 1 -%}
            <button type="button" class="mens-pdp__arrow mens-pdp__arrow--prev" data-mens-prev aria-label="Previous image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M15 6l-6 6 6 6"/></svg>
            </button>
            <button type="button" class="mens-pdp__arrow mens-pdp__arrow--next" data-mens-next aria-label="Next image">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M9 6l6 6-6 6"/></svg>
            </button>
            <span class="mens-pdp__counter" data-mens-counter></span>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ===== Info column ===== {%- endcomment -%}
      <div class="mens-pdp__info">
        {%- if rating != blank or section.settings.offer_text != blank -%}
          <div class="mens-pdp__meta">
            {%- if rating != blank -%}
              <span class="mens-pdp__rating">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/></svg>
                {{ rating.rating | round: 1 }}
                {%- if rating_count -%}<small>({{ rating_count }})</small>{%- endif -%}
              </span>
            {%- endif -%}
            {%- if section.settings.offer_text != blank -%}
              <span class="mens-pdp__offer">{{ section.settings.offer_text }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div>
          {%- if section.settings.show_vendor and product.vendor != blank -%}
            <p class="mens-pdp__vendor">{{ product.vendor }}</p>
          {%- endif -%}
          <div class="mens-pdp__titlerow">
            <h1 class="mens-pdp__title">{{ product.title }}</h1>
            {%- if section.settings.show_share -%}
              <button type="button" class="mens-pdp__share" data-mens-share aria-label="Share">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 4h6v6"/><path d="M20 4l-9 9"/><path d="M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5"/></svg>
              </button>
            {%- endif -%}
          </div>
          {%- if subtitle != blank -%}
            <p class="mens-pdp__subtitle">{{ subtitle }}</p>
          {%- elsif section.settings.show_type_as_subtitle and product.type != blank -%}
            <p class="mens-pdp__subtitle">{{ product.type }}</p>
          {%- endif -%}
        </div>

        <div class="mens-pdp__price" aria-live="polite">
          <span class="mens-pdp__price-now" data-mens-price>{{ current_variant.price | money }}</span>
          <s class="mens-pdp__price-was" data-mens-compare{% unless on_sale %} hidden{% endunless %}>{% if on_sale %}{{ current_variant.compare_at_price | money }}{% endif %}</s>
          <span class="mens-pdp__price-off" data-mens-off{% unless on_sale %} hidden{% endunless %}>{% if on_sale %}{{ off_pct }}% Off{% endif %}</span>
        </div>
        {%- if section.settings.tax_note != blank -%}
          <p class="mens-pdp__tax">{{ section.settings.tax_note }}</p>
        {%- endif -%}

        {%- if section.settings.emi_text != blank -%}
          <div class="mens-pdp__emi">{{ section.settings.emi_text }}</div>
        {%- endif -%}

        {%- form 'product', product, id: 'MensProductForm', class: 'mens-pdp__form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-mens-variant-id>

          {%- unless product.has_only_default_variant -%}
            <div style="display:flex;flex-direction:column;gap:20px;margin-bottom:22px;">
              {%- for option in product.options_with_values -%}
                {%- assign oname = option.name | downcase -%}
                {%- assign is_color = false -%}
                {%- if oname == 'color' or oname == 'colour' or oname == 'colors' or oname == 'colours' -%}{%- assign is_color = true -%}{%- endif -%}
                <fieldset class="mens-pdp__option" data-mens-option>
                  <legend>Choose your {{ option.name | downcase }}: <span data-mens-option-label>{{ option.selected_value }}</span></legend>
                  <div class="mens-pdp__values">
                    {%- for value in option.values -%}
                      <label class="mens-pdp__value{% unless value.available %} is-unavailable{% endunless %}" title="{{ value | escape }}">
                        <input type="radio" name="mens-option-{{ section.id }}-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"{% if value.selected %} checked{% endif %}>
                        {%- if is_color -%}
                          <span class="mens-pdp__value-img">
                            {%- if value.variant.featured_image -%}
                              {{ value.variant.featured_image | image_url: width: 140 | image_tag: loading: 'lazy', alt: value }}
                            {%- elsif value.swatch.image -%}
                              {{ value.swatch.image | image_url: width: 140 | image_tag: loading: 'lazy', alt: value }}
                            {%- elsif value.swatch.color -%}
                              <span style="background: {{ value.swatch.color }};"></span>
                            {%- else -%}
                              <span style="background: {{ value | handle | replace: '-', '' }};"></span>
                            {%- endif -%}
                          </span>
                        {%- else -%}
                          <span class="mens-pdp__value-text">{{ value }}</span>
                        {%- endif -%}
                      </label>
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <div class="mens-pdp__buy">
            {%- if section.settings.show_quantity -%}
              <div class="mens-qty" data-mens-qty>
                <button type="button" data-minus aria-label="Decrease quantity"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/></svg></button>
                <input type="number" name="quantity" value="1" min="1" {% if current_variant.quantity_rule.max %}max="{{ current_variant.quantity_rule.max }}"{% endif %} aria-label="Quantity">
                <button type="button" data-plus aria-label="Increase quantity">{{ plus_icon }}</button>
              </div>
            {%- endif -%}
            <button type="submit" class="mens-btn mens-btn--ghost" data-mens-add{% unless current_variant.available %} disabled{% endunless %}{% unless section.settings.show_quantity %} style="grid-column: 1 / 2;"{% endunless %}>
              {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
            </button>
            {%- if section.settings.show_buy_now -%}
              <button type="submit" name="return_to" value="/checkout" class="mens-btn mens-btn--primary" data-mens-buynow{% unless current_variant.available %} disabled{% endunless %}>
                Buy now
              </button>
            {%- endif -%}
          </div>
          {%- if section.settings.show_stock -%}
            {%- liquid
              assign stock_class = ''
              if current_variant.available == false
                assign stock_class = ' is-out'
              elsif current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5
                assign stock_class = ' is-low'
              endif
            -%}
            <p class="mens-pdp__stock{{ stock_class }}" data-mens-stock style="margin-top:12px;">
              {%- if current_variant.available == false -%}Sold out
              {%- elsif stock_class == ' is-low' -%}Only {{ current_variant.inventory_quantity }} left – order soon
              {%- else -%}In stock, ready to ship{%- endif -%}
            </p>
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.show_delivery -%}
          <div class="mens-pdp__delivery">
            <h3>Check delivery</h3>
            <div class="mens-pdp__pin">
              <form class="mens-pdp__pin-row" data-mens-pin
                    data-min="{{ section.settings.delivery_min }}"
                    data-max="{{ section.settings.delivery_max }}"
                    data-pattern="{{ section.settings.pin_pattern | escape }}"
                    data-error="{{ section.settings.pin_error | escape }}"
                    data-label="{{ section.settings.delivery_label | escape }}"
                    data-note="{{ section.settings.delivery_note | escape }}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s-7-6.1-7-11a7 7 0 0114 0c0 4.9-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
                <input type="text" inputmode="numeric" autocomplete="postal-code" placeholder="{{ section.settings.pin_placeholder | escape }}" aria-label="{{ section.settings.pin_placeholder | escape }}">
                <button type="submit" class="mens-btn mens-btn--primary mens-btn--sm">Check</button>
              </form>
              <p class="mens-pdp__pin-result" data-mens-pin-result aria-live="polite"></p>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.perk_1 != blank or section.settings.perk_2 != blank or section.settings.perk_3 != blank -%}
          <div class="mens-pdp__perks">
            {%- if section.settings.perk_1 != blank -%}
              <div class="mens-pdp__perk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 4v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>{{ section.settings.perk_1 }}</div>
            {%- endif -%}
            {%- if section.settings.perk_2 != blank -%}
              <div class="mens-pdp__perk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12a8 8 0 018-8c3 0 5.5 1.5 7 4"/><path d="M20 4v5h-5"/><path d="M20 12a8 8 0 01-8 8c-3 0-5.5-1.5-7-4"/><path d="M4 20v-5h5"/></svg>{{ section.settings.perk_2 }}</div>
            {%- endif -%}
            {%- if section.settings.perk_3 != blank -%}
              <div class="mens-pdp__perk"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5L16 9.5"/></svg>{{ section.settings.perk_3 }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="mens-acc">
          {%- if product.description != blank -%}
            <details open>
              <summary>Description {{ plus_icon }}</summary>
              <div class="mens-acc__body">{{ product.description }}</div>
            </details>
          {%- endif -%}
          {%- for block in section.blocks -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.heading }} {{ plus_icon }}</summary>
              <div class="mens-acc__body">
                {{ block.settings.content }}
                {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
              </div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-mens-pdp-json>
    {
      "money": {{ shop.money_format | strip_html | json }},
      "strings": {
        "add": "Add to cart",
        "soldout": "Sold out",
        "unavailable": "Unavailable",
        "instock": "In stock, ready to ship",
        "low": "Only [count] left – order soon",
        "copied": "Link copied"
      },
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "options": {{ v.options | json }},
            "price": {{ v.price }},
            "compare": {{ v.compare_at_price | default: 0 }},
            "available": {{ v.available }},
            "qty": {% if v.inventory_management == 'shopify' %}{{ v.inventory_quantity }}{% else %}null{% endif %},
            "media": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
</div>

{% schema %}
{
  "name": "Mens product page",
  "tag": "section",
  "class": "mens-product-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "header", "content": "Gallery" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    {
      "type": "select", "id": "media_ratio", "label": "Main image shape", "default": "1 / 1",
      "options": [
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 4", "label": "Tall" }
      ]
    },
    {
      "type": "select", "id": "media_fit", "label": "Image fit", "default": "contain",
      "options": [ { "value": "contain", "label": "Show whole image" }, { "value": "cover", "label": "Fill the frame" } ]
    },
    { "type": "checkbox", "id": "show_sale_badge", "label": "Show % off badge on image", "default": true },
    { "type": "header", "content": "Product info" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_type_as_subtitle", "label": "Show product type as subtitle", "default": true, "info": "A product metafield custom.subtitle takes priority when filled." },
    { "type": "checkbox", "id": "show_share", "label": "Show share button", "default": true },
    { "type": "text", "id": "offer_text", "label": "Offer pill", "default": "Extra 10% off with code WELCOME10", "info": "Red pill above the title. Leave empty to hide." },
    { "type": "text", "id": "tax_note", "label": "Price note", "default": "MRP (inclusive of all taxes)" },
    { "type": "richtext", "id": "emi_text", "label": "Offer / EMI box", "info": "Optional bordered box under the price." },
    { "type": "header", "content": "Buying" },
    { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true },
    { "type": "checkbox", "id": "show_buy_now", "label": "Show Buy now button", "default": true },
    { "type": "checkbox", "id": "show_stock", "label": "Show stock status", "default": true },
    { "type": "header", "content": "Delivery check" },
    { "type": "checkbox", "id": "show_delivery", "label": "Show delivery check", "default": true },
    { "type": "paragraph", "content": "Shows an estimated delivery date range for a valid PIN code. It does not check real courier serviceability." },
    { "type": "text", "id": "pin_placeholder", "label": "Input placeholder", "default": "Enter PIN code" },
    { "type": "text", "id": "pin_pattern", "label": "Valid PIN pattern (regex)", "default": "^[1-9][0-9]{5}$" },
    { "type": "text", "id": "pin_error", "label": "Invalid PIN message", "default": "Please enter a valid 6-digit PIN code." },
    { "type": "text", "id": "delivery_label", "label": "Result label", "default": "Estimated delivery" },
    { "type": "range", "id": "delivery_min", "label": "Minimum business days", "min": 1, "max": 15, "step": 1, "default": 3 },
    { "type": "range", "id": "delivery_max", "label": "Maximum business days", "min": 1, "max": 20, "step": 1, "default": 6 },
    { "type": "text", "id": "delivery_note", "label": "Extra note", "default": "Cash on delivery available. Free shipping above Rs. 999." },
    { "type": "header", "content": "Perks row" },
    { "type": "text", "id": "perk_1", "label": "Perk 1 (truck icon)", "default": "Free shipping" },
    { "type": "text", "id": "perk_2", "label": "Perk 2 (returns icon)", "default": "7-day easy returns" },
    { "type": "text", "id": "perk_3", "label": "Perk 3 (shield icon)", "default": "100% original" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Info tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Orders ship within 24 hours. Easy 7-day returns and exchanges on unused items with tags attached.</p>" },
        { "type": "page", "id": "page", "label": "Or show content from a page" }
      ]
    }
  ]
}
{% endschema %}
