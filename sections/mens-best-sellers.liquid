{{ 'mens-theme.css' | asset_url | stylesheet_tag }}

{%- assign col = section.settings.collection -%}
{%- assign has_products = false -%}
{%- if col != blank and col.all_products_count > 0 -%}
  {%- assign has_products = true -%}
{%- endif -%}

<section class="mens-section{% if section.settings.soft_background %} mens-section--soft{% endif %}">
  <div class="mens-wrap">
    <div class="mens-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="mens-head__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="mens-head__title">{{ section.settings.heading | default: 'Best sellers' }}</h2>
      </div>
      {%- if section.settings.view_all_label != blank -%}
        <a href="{{ section.settings.view_all_link | default: col.url }}" class="mens-head__link">{{ section.settings.view_all_label }} <span aria-hidden="true">›</span></a>
      {%- endif -%}
    </div>

    {%- if has_products -%}
      <div class="mens-grid" style="--mens-cols: {{ section.settings.columns_desktop }};">
        {%- for product in col.products limit: section.settings.products_to_show -%}
          {% render 'mens-product-card', product: product, show_quick_add: true, show_vendor: true %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="mens-grid" style="--mens-cols: {{ section.settings.columns_desktop }};">
        {%- for i in (1..section.settings.products_to_show) -%}
          <article class="mens-card">
            <div class="mens-card__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg mens-card__img mens-card__img--primary' }}</div>
            <div class="mens-card__info">
              <p class="mens-card__vendor">Jackets</p>
              <h3 class="mens-card__title">Field Jacket</h3>
              <div class="mens-card__price"><span>$149.00</span></div>
            </div>
          </article>
        {%- endfor -%}
      </div>
      <p class="mens-tabs__hint">
        {%- if col == blank -%}
          Pick a collection in the section settings to display real products.
        {%- else -%}
          The "{{ col.title }}" collection is empty — add products in Shopify admin → Products or switch the collection.
        {%- endif -%}
      </p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Mens best sellers",
  "tag": "section",
  "class": "mens-best-sellers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Most loved" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Number of products", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "select", "id": "columns_desktop", "label": "Columns on desktop", "options": [
      { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }
    ], "default": "4" },
    { "type": "text", "id": "view_all_label", "label": "Link label", "default": "Shop all" },
    { "type": "url", "id": "view_all_link", "label": "Link URL" },
    { "type": "checkbox", "id": "soft_background", "label": "Soft background", "default": false }
  ],
  "presets": [ { "name": "Mens best sellers" } ]
}
{% endschema %}
