{{ 'mens-theme.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign aspect_w = section.settings.aspect_w | default: 1920
  assign aspect_h = section.settings.aspect_h | default: 1301
  assign mobile_h = section.settings.mobile_height | default: 560
-%}

<section class="mens-banner mens-banner--align-{{ section.settings.text_position }}"
         style="
           --mens-banner-aspect: {{ aspect_w }} / {{ aspect_h }};
           --mens-banner-mobile-h: {{ mobile_h }}px;
           --mens-banner-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
           --mens-banner-text: {{ section.settings.text_color }};
           --mens-banner-max: {{ section.settings.max_width }}px;
         ">
  <div class="mens-banner__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image
         | image_url: width: 2400
         | image_tag:
           loading: 'eager',
           fetchpriority: 'high',
           widths: '720,1100,1600,2000,2400,3000',
           sizes: '100vw',
           class: 'mens-banner__img',
           alt: section.settings.heading | default: section.settings.image.alt | escape }}
    {%- else -%}
      <img class="mens-banner__img"
           src="{{ 'mens-hero-default.svg' | asset_url }}"
           alt="{{ section.settings.heading | default: 'Mens hero' | escape }}">
    {%- endif -%}
  </div>
  <div class="mens-banner__scrim"></div>

  <div class="mens-banner__inner">
    <div class="mens-banner__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="mens-banner__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="mens-banner__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="mens-banner__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="mens-banner__btn">
          <span>{{ section.settings.button_label }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mens hero banner",
  "tag": "section",
  "class": "mens-hero-banner-section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Banner image" },
    { "type": "paragraph", "content": "Upload at 1920 × 1301 px (3:2) or 2× (3840 × 2602) for retina — the section keeps this exact ratio on all screens and crops only the top/bottom edges when the viewport is wider." },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear confidence, own every moment" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Elevate your everyday wardrobe with premium essentials, statement pieces, and effortless elegance." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "text_position", "label": "Text position", "options": [
      { "value": "top-left", "label": "Top left" },
      { "value": "top-center", "label": "Top center" },
      { "value": "top-right", "label": "Top right" },
      { "value": "middle-left", "label": "Middle left" },
      { "value": "middle-center", "label": "Middle center" },
      { "value": "bottom-left", "label": "Bottom left" },
      { "value": "bottom-center", "label": "Bottom center" }
    ], "default": "top-left" },
    { "type": "range", "id": "max_width", "label": "Content max width", "min": 320, "max": 720, "step": 10, "unit": "px", "default": 520 },
    { "type": "color", "id": "text_color", "label": "Text colour", "default": "#111111" },
    { "type": "range", "id": "overlay_opacity", "label": "Image darken", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 0 },

    { "type": "header", "content": "Image ratio (advanced)" },
    { "type": "number", "id": "aspect_w", "label": "Aspect width", "default": 1920 },
    { "type": "number", "id": "aspect_h", "label": "Aspect height", "default": 1301 },
    { "type": "range", "id": "mobile_height", "label": "Mobile height", "min": 360, "max": 760, "step": 10, "unit": "px", "default": 560 }
  ],
  "presets": [
    { "name": "Mens hero banner" }
  ]
}
{% endschema %}
