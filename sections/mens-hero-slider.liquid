{{ 'mens-theme.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mens-theme.js' | asset_url }}" defer></script>

<section class="mens-hero"
         data-mens-hero
         data-autoplay="{{ section.settings.autoplay }}"
         data-interval="{{ section.settings.interval | times: 1000 }}"
         style="--mens-ink: {{ section.settings.text_color }};">
  <div class="mens-hero__track" data-mens-hero-track>
    {%- for block in section.blocks -%}
      <div class="mens-hero__slide" data-mens-hero-slide {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 2200 | image_tag:
            loading: forloop.first | default: false,
            widths: '720,1100,1600,2000,2400',
            sizes: '100vw',
            class: 'mens-hero__img',
            alt: block.settings.heading | default: block.settings.image.alt | escape }}
        {%- else -%}
          <div class="mens-hero__img" style="background: linear-gradient(120deg,#1b1b1f,#3a3a40);"></div>
        {%- endif -%}
        <div class="mens-hero__overlay"></div>
        <div class="mens-hero__inner">
          {%- if block.settings.eyebrow != blank -%}
            <span class="mens-hero__eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h2 class="mens-hero__title">{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="mens-hero__text">{{ block.settings.text }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link }}" class="mens-btn mens-btn--light">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>
        {%- if block.settings.chip_label != blank -%}
          <a href="{{ block.settings.chip_link }}" class="mens-hero__chip">
            {%- if block.settings.chip_image != blank -%}
              {{ block.settings.chip_image | image_url: width: 80 | image_tag: loading: 'lazy', alt: block.settings.chip_label | escape }}
            {%- endif -%}
            <span>{{ block.settings.chip_label }}</span>
            <span class="mens-hero__chip-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M5 12h14M13 5l7 7-7 7"/></svg></span>
          </a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="mens-hero__nav">
      <div class="mens-hero__dots" data-mens-hero-dots></div>
      <div class="mens-hero__arrows">
        <button type="button" class="mens-hero__arrow" data-mens-hero-prev aria-label="Previous slide"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M15 18l-6-6 6-6"/></svg></button>
        <button type="button" class="mens-hero__arrow" data-mens-hero-next aria-label="Next slide"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M9 6l6 6-6 6"/></svg></button>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Mens hero slider",
  "tag": "section",
  "class": "mens-hero-wrap",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Behaviour" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay", "default": true },
    { "type": "range", "id": "interval", "label": "Autoplay interval", "unit": "s", "min": 3, "max": 12, "step": 1, "default": 6 },
    { "type": "color", "id": "text_color", "label": "Text accent", "default": "#ffffff" }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New arrivals" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Dress sharp, live bold." },
        { "type": "textarea", "id": "text", "label": "Description", "default": "Premium essentials, tailored for the modern man." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the look" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "header", "content": "Bottom-right chip (optional)" },
        { "type": "image_picker", "id": "chip_image", "label": "Chip image" },
        { "type": "text", "id": "chip_label", "label": "Chip label" },
        { "type": "url", "id": "chip_link", "label": "Chip link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mens hero slider",
      "blocks": [
        { "type": "slide", "settings": { "eyebrow": "Autumn drop", "heading": "Dress sharp, live bold.", "text": "Premium essentials, tailored for the modern man.", "button_label": "Shop the look", "chip_label": "Oxford Shirt" } },
        { "type": "slide", "settings": { "eyebrow": "Essentials", "heading": "Built for the every day.", "text": "Clean cuts, honest fabrics.", "button_label": "Explore", "chip_label": "Chore Jacket" } }
      ]
    }
  ]
}
{% endschema %}
