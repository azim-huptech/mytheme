{{ 'mens-theme.css' | asset_url | stylesheet_tag }}

<section class="mens-section">
  <div class="mens-wrap">
    <div class="mens-contact">
      <div class="mens-contact__info">
        {%- if section.settings.eyebrow != blank -%}
          <p class="mens-head__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading | default: 'Get in touch' }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p>{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.settings.address != blank -%}
          <div class="mens-contact__row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s7-7 7-13a7 7 0 10-14 0c0 6 7 13 7 13z"/><circle cx="12" cy="9" r="2.5"/></svg>
            <div><strong>Visit us</strong><br>{{ section.settings.address }}</div>
          </div>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <div class="mens-contact__row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7c.1.9.3 1.8.6 2.6a2 2 0 01-.5 2.1L8 9.6a16 16 0 006 6l1.2-1.2a2 2 0 012.1-.5c.8.3 1.7.5 2.6.6a2 2 0 011.7 2z"/></svg>
            <div><strong>Call</strong><br><a href="tel:{{ section.settings.phone | strip }}">{{ section.settings.phone }}</a></div>
          </div>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <div class="mens-contact__row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
            <div><strong>Email</strong><br><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></div>
          </div>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <div class="mens-contact__row">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <div><strong>Hours</strong><br>{{ section.settings.hours }}</div>
          </div>
        {%- endif -%}
      </div>

      <div class="mens-contact__form">
        {%- form 'contact', id: 'ContactFormMens' -%}
          {%- if form.posted_successfully? -%}
            <p style="color: var(--mens-new); font-weight:600;">Thanks — we'll get back to you shortly.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p style="color: var(--mens-sale);">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <div class="field">
            <label class="field__label" for="MensContactName">Name</label>
            <input class="field__input" type="text" name="contact[name]" id="MensContactName" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
          </div>
          <div class="field">
            <label class="field__label" for="MensContactEmail">Email</label>
            <input class="field__input" type="email" name="contact[email]" id="MensContactEmail" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocomplete="email" required>
          </div>
          <div class="field">
            <label class="field__label" for="MensContactPhone">Phone (optional)</label>
            <input class="field__input" type="tel" name="contact[phone]" id="MensContactPhone" value="{% if form.phone %}{{ form.phone }}{% endif %}" autocomplete="tel">
          </div>
          <div class="field">
            <label class="field__label" for="MensContactBody">Message</label>
            <textarea class="text-area" name="contact[body]" id="MensContactBody" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>
          <button type="submit" class="mens-btn mens-btn--primary" style="width:100%;">{{ section.settings.button_label | default: 'Send message' }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mens contact",
  "tag": "section",
  "class": "mens-contact-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Contact" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We're here to help." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Questions about sizing, orders or anything else — drop us a line." },
    { "type": "text", "id": "address", "label": "Address", "default": "221B Baker Street, London" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+1 (555) 123-4567" },
    { "type": "text", "id": "email", "label": "Email", "default": "support@yourstore.com" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon – Sat, 10am – 7pm" },
    { "type": "text", "id": "button_label", "label": "Submit button label", "default": "Send message" }
  ],
  "presets": [ { "name": "Mens contact" } ]
}
{% endschema %}
