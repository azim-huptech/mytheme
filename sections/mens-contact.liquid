{{ 'mens-theme.css' | asset_url | stylesheet_tag }}

<section class="mens-section mens-contact-wrap" style="background: {{ section.settings.background }};">
  <div class="mens-wrap">
    <div class="mens-contact-v2">
      <aside class="mens-contact-v2__side" style="background: {{ section.settings.side_background }}; color: {{ section.settings.side_text }};">
        {%- if section.settings.eyebrow != blank -%}
          <span class="mens-contact-v2__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="mens-contact-v2__title">{{ section.settings.heading | default: "Let's talk." }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="mens-contact-v2__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <ul class="mens-contact-v2__list">
          {%- if section.settings.address != blank -%}
            <li>
              <span class="mens-contact-v2__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><path d="M12 22s7-7 7-13a7 7 0 10-14 0c0 6 7 13 7 13z"/><circle cx="12" cy="9" r="2.5"/></svg></span>
              <div><strong>Address</strong><p>{{ section.settings.address }}</p></div>
            </li>
          {%- endif -%}
          {%- if section.settings.phone != blank -%}
            <li>
              <span class="mens-contact-v2__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><path d="M22 16.9v3a2 2 0 01-2.2 2 19.8 19.8 0 01-8.6-3.1 19.5 19.5 0 01-6-6A19.8 19.8 0 012.1 4.2 2 2 0 014.1 2h3a2 2 0 012 1.7"/></svg></span>
              <div><strong>Phone</strong><p><a href="tel:{{ section.settings.phone | strip }}" style="color:inherit;">{{ section.settings.phone }}</a></p></div>
            </li>
          {%- endif -%}
          {%- if section.settings.email != blank -%}
            <li>
              <span class="mens-contact-v2__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
              <div><strong>Email</strong><p><a href="mailto:{{ section.settings.email }}" style="color:inherit;">{{ section.settings.email }}</a></p></div>
            </li>
          {%- endif -%}
          {%- if section.settings.hours != blank -%}
            <li>
              <span class="mens-contact-v2__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="20" height="20"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
              <div><strong>Hours</strong><p>{{ section.settings.hours }}</p></div>
            </li>
          {%- endif -%}
        </ul>

        <div class="mens-contact-v2__socials">
          {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>{%- endif -%}
          {%- if section.settings.facebook != blank -%}<a href="{{ section.settings.facebook }}" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M13.5 22v-8h2.7l.4-3.1h-3.1V8.9c0-.9.3-1.5 1.6-1.5h1.6V4.6c-.3 0-1.3-.1-2.4-.1-2.3 0-3.9 1.4-3.9 4v2.4H7.6V14h2.8v8h3.1z"/></svg></a>{%- endif -%}
          {%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}" aria-label="TikTok"><svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M20 8.5a7 7 0 01-4-1.3V15a6 6 0 11-6-6v3a3 3 0 103 3V2h3a4 4 0 004 4v2.5z"/></svg></a>{%- endif -%}
        </div>
      </aside>

      <div class="mens-contact-v2__formwrap">
        <h3 class="mens-contact-v2__formtitle">{{ section.settings.form_title | default: 'Send a message' }}</h3>
        <p class="mens-contact-v2__formsub">{{ section.settings.form_subtitle | default: "We'll get back to you within one business day." }}</p>
        {%- form 'contact', id: 'ContactFormMens' -%}
          {%- if form.posted_successfully? -%}
            <div class="mens-contact-v2__ok">Thanks — we'll get back to you shortly.</div>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="mens-contact-v2__err">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="mens-contact-v2__grid">
            <label class="field">
              <span class="field__label">Name</span>
              <input class="field__input" type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" required>
            </label>
            <label class="field">
              <span class="field__label">Email</span>
              <input class="field__input" type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocomplete="email" required>
            </label>
            <label class="field">
              <span class="field__label">Phone (optional)</span>
              <input class="field__input" type="tel" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% endif %}" autocomplete="tel">
            </label>
            <label class="field">
              <span class="field__label">Subject</span>
              <input class="field__input" type="text" name="contact[subject]" value="{% if form.subject %}{{ form.subject }}{% endif %}">
            </label>
          </div>
          <label class="field field--full">
            <span class="field__label">Message</span>
            <textarea class="text-area" name="contact[body]" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </label>
          <button type="submit" class="mens-btn mens-btn--primary mens-contact-v2__submit">{{ section.settings.button_label | default: 'Send message' }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Mens contact",
  "tag": "section",
  "class": "mens-contact-section",
  "settings": [
    { "type": "color", "id": "background", "label": "Section background", "default": "#ffffff" },
    { "type": "header", "content": "Left panel" },
    { "type": "color", "id": "side_background", "label": "Panel background", "default": "#0f0f10" },
    { "type": "color", "id": "side_text", "label": "Panel text", "default": "#ffffff" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Let's talk." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Sizing questions, orders or anything else — drop us a line and we'll reply within one business day." },
    { "type": "text", "id": "address", "label": "Address", "default": "221B Baker Street, London" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+1 (555) 123-4567" },
    { "type": "text", "id": "email", "label": "Email", "default": "support@yourstore.com" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon – Sat, 10am – 7pm" },
    { "type": "header", "content": "Socials" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "url", "id": "facebook", "label": "Facebook URL" },
    { "type": "url", "id": "tiktok", "label": "TikTok URL" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_title", "label": "Form title", "default": "Send a message" },
    { "type": "text", "id": "form_subtitle", "label": "Form subtitle", "default": "We'll get back to you within one business day." },
    { "type": "text", "id": "button_label", "label": "Submit button", "default": "Send message" }
  ],
  "presets": [ { "name": "Mens contact" } ]
}
{% endschema %}
